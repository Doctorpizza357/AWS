rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each doc is keyed by Firebase Auth UID
    match /users/{userId} {
      // Any authenticated user can read any user profile (needed for leaderboard)
      allow read: if request.auth != null;

      // Users can only write to their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // Only the user themselves can delete their document
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Friends subcollection: both users can read; either party can write
      match /friends/{friendId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // Presence collection: real-time online status for campus multiplayer
    match /presence/{userId} {
      // Any authenticated user can read all presence docs (to see other players)
      allow read: if request.auth != null;

      // Users can only write their own presence
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Friend requests collection
    match /friendRequests/{requestId} {
      // Any authenticated user can read requests (filtered by query on client)
      allow read: if request.auth != null;

      // Any authenticated user can create a request (from field must match their uid)
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;

      // Recipient can update (accept/reject), sender can also update (cancel)
      allow update: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      // Either party can delete
      allow delete: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Interview challenges collection (real-time pose sharing)
    match /challenges/{challengeId} {
      // Both participants can read
      allow read: if request.auth != null;

      // Any authenticated user can create (challenger must match their uid)
      allow create: if request.auth != null && request.resource.data.challenger == request.auth.uid;

      // Both participants can update (pose data, results, status)
      allow update: if request.auth != null &&
        (resource.data.challenger == request.auth.uid || resource.data.opponent == request.auth.uid);

      // Either participant can delete
      allow delete: if request.auth != null &&
        (resource.data.challenger == request.auth.uid || resource.data.opponent == request.auth.uid);
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
